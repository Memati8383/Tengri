#include <windows.h>
// windows.h, VS_VERSION_INFO dilbilgisini içeri almıyor; aşağıdaki her anahtar
// olmasaydı kaynak dosya adı sanılıp ayrıştırma hatası verirdi.
#include <winver.h>

// Sürüm src\brand.hpp'de tek yerde durur. tools\make_version.ps1 her derlemede
// build\obj\version.h üretir ve aşağıdaki include onu okur. TENGRI_HAS_VERSION_H
// tanımlıysa üretilmiş başlık kullanılır; tanımlı değilse (IDE'den elle derlemek gibi
// durumlarda) dosyanın içindeki varsayılanlara düşülür.
//
// About kutusu sürümü çalışan exe'den geri okuduğu için ikinci bir kopya taşımıyor.
#ifdef TENGRI_HAS_VERSION_H
#include "version.h"
#endif

#ifndef TENGRI_VER_MAJOR
#define TENGRI_VER_MAJOR 1
#define TENGRI_VER_MINOR 0
#define TENGRI_VER_PATCH 0
#define TENGRI_VERSION_STR      "1.0.0"
#define TENGRI_PUBLISHER_STR    "TENGRI Project"
#define TENGRI_DESCRIPTION_STR  "TENGRI - System Optimizer"
#endif

// Ayrıca src\brand.hpp içinde brand::kIconId olarak tanımlı; iki tarafın uyuşması
// gerekir, aksi hâlde LoadIconW hiç derlenmemiş bir kimliği arar.
#define IDI_APPICON 101

IDI_APPICON          ICON            "tengri.ico"
1 RT_MANIFEST "app.manifest"

VS_VERSION_INFO VERSIONINFO
  FILEVERSION    TENGRI_VER_MAJOR,TENGRI_VER_MINOR,TENGRI_VER_PATCH,0
  PRODUCTVERSION TENGRI_VER_MAJOR,TENGRI_VER_MINOR,TENGRI_VER_PATCH,0
  FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
  FILEFLAGS      VS_FF_DEBUG
#else
  FILEFLAGS      0x0L
#endif
  FILEOS         VOS_NT_WINDOWS32
  FILETYPE       VFT_APP
  FILESUBTYPE    VFT2_UNKNOWN
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"                       // İngilizce, Unicode
    BEGIN
      VALUE "CompanyName",      TENGRI_PUBLISHER_STR
      VALUE "FileDescription",  TENGRI_DESCRIPTION_STR
      VALUE "FileVersion",      TENGRI_VERSION_STR
      VALUE "InternalName",     "TENGRI"
      VALUE "LegalCopyright",   "Distributed under the MIT License. See LICENSE."
      VALUE "OriginalFilename", "TENGRI.exe"
      VALUE "ProductName",      "TENGRI"
      VALUE "ProductVersion",   TENGRI_VERSION_STR
    END
  END

  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END