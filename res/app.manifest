<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <assemblyIdentity type="win32" name="Tengri.SystemOptimizer" version="1.0.0.0" processorArchitecture="amd64" />
  <description>TENGRI - System Optimizer</description>

  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v3">
    <security>
      <requestedPrivileges>
        <!-- asInvoker, not requireAdministrator: the Games, FiveM, Delay and RAM
             categories all write HKLM, but almost nothing else needs elevation. The app
             used to start elevated, which meant opening a system-info screen cost a UAC
             prompt. It now starts as the invoking user; when an action actually writes
             HKLM the process relaunches itself via "runas" (see src/core/elevate.cpp)
             and performs that one action elevated. -->
        <requestedExecutionLevel level="asInvoker" uiAccess="false" />
      </requestedPrivileges>
    </security>
  </trustInfo>

  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 and 11. Without this the OS assumes Win7 and the taskbar and DPI
           heuristics behave differently. -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}" />
    </application>
  </compatibility>

  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <dpiAwareness xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">PerMonitorV2</dpiAwareness>
      <!-- activeCodePage is deliberately NOT set: the app still calls ANSI APIs
           (GetComputerNameA, adapter GUIDs via CP_ACP), and switching the process ACP
           to UTF-8 would change what those return. -->
    </windowsSettings>
  </application>
</assembly>